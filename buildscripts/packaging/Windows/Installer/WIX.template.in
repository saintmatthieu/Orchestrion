<?xml version="1.0" encoding="UTF-8"?>

<?include "cpack_variables.wxi"?>

<?define ProdName="$(var.MUSE_APP_TITLE_VERSION)"?>
<?define ShortProdName="$(var.MUSE_APP_TITLE) $(var.CPACK_PACKAGE_VERSION_MAJOR) $(var.MUSE_APP_RELEASE_CHANNEL)"?>
<?define ExeKey="$(var.ShortProdName).exe"?>
<?define ExeName="$(var.MUSESCORE_EXECUTABLE_NAME).exe"?>
<?define RegistryRoot="HKMU"?> <!--HKCU / HKLM-->

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" RequiredVersion="3.6.3303.0">

    <Product Id="$(var.CPACK_WIX_PRODUCT_GUID)"
        Name="$(var.ProdName)"
        Language="1033"
        Version="$(var.CPACK_PACKAGE_VERSION)"
        Manufacturer="$(var.CPACK_PACKAGE_VENDOR)"
        UpgradeCode="$(var.CPACK_WIX_UPGRADE_GUID)">

        <Package InstallerVersion="301" Compressed="yes" />

        <Media Id="1" Cabinet="media1.cab" EmbedCab="yes" CompressionLevel="high" />

        <!-- AllowDowngrades (which also covers same-version reinstalls) is
             required for the one-time transition from the MuseScore-inherited
             4.4.4.x product version down to Orchestrion's own 0.x versions:
             without it, machines holding a 4.4.4.x install would reject the
             new MSIs as downgrades. -->
        <MajorUpgrade AllowDowngrades="yes" />

        <WixVariable Id="WixUILicenseRtf" Value="$(var.CPACK_WIX_LICENSE_RTF)" />
        <Property Id="WIXUI_INSTALLDIR" Value="INSTALL_ROOT" />

        <!-- See https://docs.microsoft.com/ru-ru/windows/win32/msi/reinstallmode that explains different modes -->
        <Property Id='REINSTALLMODE' Value='dmus' />

        <?ifdef CPACK_WIX_PRODUCT_ICON?>
        <Property Id="ARPPRODUCTICON">ProductIcon.ico</Property>
        <Icon Id="ProductIcon.ico" SourceFile="$(var.CPACK_WIX_PRODUCT_ICON)" />
        <?endif?>

        <?ifdef CPACK_WIX_UI_BANNER?>
        <WixVariable Id="WixUIBannerBmp" Value="$(var.CPACK_WIX_UI_BANNER)" />
        <?endif?>

        <?ifdef CPACK_WIX_UI_DIALOG?>
        <WixVariable Id="WixUIDialogBmp" Value="$(var.CPACK_WIX_UI_DIALOG)" />
        <?endif?>

        <Property Id='ARPHELPLINK'>https://github.com/saintmatthieu/Orchestrion</Property>
        <Property Id='ARPURLINFOABOUT'>https://orchestrion.app/</Property>
        <!-- Properties from CMake -->
        <?include "properties.wxi"?>

        <!-- Add to checkbox to launch program after install ²-->
        <UI>
            <!-- Custom copy of WixUI_InstallDir (see WixUI_Orchestrion.wxs). -->
            <UIRef Id='WixUI_InstallDir_Orchestrion' />
            <Publish Dialog="OrchestrionExitDialog"
                Control="Finish"
                Event="DoAction"
                Value="LaunchApplication">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>
        </UI>
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="!(loc.ExitDialogLaunchText)" />
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
        <Property Id="WixShellExecTarget" Value="[#CM_FP_bin.$(var.ExeName)]" />
        <CustomAction Id="LaunchApplication" BinaryKey="WixCA" DllEntry="WixShellExec" Impersonate="yes" />

        <!-- orchestrion:// links (see IOpenRequestHandler), and MusicXML files
             offered under "Open with" without becoming their default
             application: MuseScore and other notation programs keep theirs.
             New GUID: the component used to register MuseScore's own types
             and musescore:// scheme. -->
        <Component Id="RegisterTypes" Directory="TARGETDIR" Guid="7f55c1f8-9972-443b-bad4-d2819c400721">
            <!-- In order to work with Default Programs -->
            <?define CapabilitiesKey="SOFTWARE\$(var.ShortProdName)\Capabilities"?>
            <?define Icon="[INSTALL_ROOT]bin\$(var.ExeName),0"?>
            <RegistryKey Root="$(var.RegistryRoot)" Key="$(var.CapabilitiesKey)">
                <RegistryValue Name="ApplicationDescription" Value="$(var.ProdName)" Type="string" KeyPath="yes" />
                <RegistryValue Name="ApplicationIcon" Value="$(var.Icon)" Type="string" />
                <RegistryValue Name="ApplicationName" Value="$(var.ProdName)" Type="string" />
                <RegistryKey Key="FileAssociations">
                    <RegistryValue Name=".mxl" Value="Orchestrion.mxl" Type="string" />
                    <RegistryValue Name=".musicxml" Value="Orchestrion.musicxml" Type="string" />
                </RegistryKey>
                <RegistryKey Key="UrlAssociations">
                    <RegistryValue Name="orchestrion" Value="orchestrion" Type="string" />
                </RegistryKey>
            </RegistryKey>

            <RegistryValue Root="$(var.RegistryRoot)" Key="SOFTWARE\RegisteredApplications" Name="$(var.ProdName)" Value="$(var.CapabilitiesKey)" Type="string" />

            <!-- App Paths to support Start,Run -> "myapp" -->
            <RegistryKey Root="$(var.RegistryRoot)" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\App Paths\$(var.ExeKey)">
                <RegistryValue Value="[INSTALL_ROOT]bin\$(var.ExeName)" Type="string" />
                <RegistryValue Name="Path" Value="[INSTALL_ROOT]bin" Type="string" />
            </RegistryKey>

            <!-- The "Open with" list -->
            <RegistryKey Root="$(var.RegistryRoot)" Key="SOFTWARE\Classes\Applications\$(var.ExeKey)">
                <RegistryKey Key="SupportedTypes">
                    <RegistryValue Name=".mxl" Value="" Type="string" />
                    <RegistryValue Name=".musicxml" Value="" Type="string" />
                </RegistryKey>
                <RegistryValue Name="FriendlyAppName" Value="$(var.ProdName)" Type="string" />
                <RegistryValue Key="shell\open" Name="FriendlyAppName" Value="$(var.ProdName)" Type="string" />
                <RegistryValue Key="shell\open\command" Value="&quot;[INSTALL_ROOT]bin\$(var.ExeName)&quot; &quot;%1&quot;" Type="string" />
            </RegistryKey>

            <!-- Orchestrion's own ProgIDs, which the extensions only list
                 (OpenWithProgids): their default value is left alone. -->
            <RegistryKey Root="$(var.RegistryRoot)" Key="SOFTWARE\Classes\Orchestrion.mxl">
                <RegistryValue Value="Compressed MusicXML File" Type="string" />
                <RegistryValue Key="DefaultIcon" Value="$(var.Icon)" Type="string" />
                <RegistryValue Key="shell\open\command" Value="&quot;[INSTALL_ROOT]bin\$(var.ExeName)&quot; &quot;%1&quot;" Type="string" />
            </RegistryKey>
            <RegistryValue Root="$(var.RegistryRoot)" Key="SOFTWARE\Classes\.mxl\OpenWithProgids" Name="Orchestrion.mxl" Value="" Type="string" />

            <RegistryKey Root="$(var.RegistryRoot)" Key="SOFTWARE\Classes\Orchestrion.musicxml">
                <RegistryValue Value="MusicXML File" Type="string" />
                <RegistryValue Key="DefaultIcon" Value="$(var.Icon)" Type="string" />
                <RegistryValue Key="shell\open\command" Value="&quot;[INSTALL_ROOT]bin\$(var.ExeName)&quot; &quot;%1&quot;" Type="string" />
            </RegistryKey>
            <RegistryValue Root="$(var.RegistryRoot)" Key="SOFTWARE\Classes\.musicxml\OpenWithProgids" Name="Orchestrion.musicxml" Value="" Type="string" />

            <!-- orchestrion:// -->
            <RegistryKey Root="$(var.RegistryRoot)" Key="SOFTWARE\Classes\orchestrion">
                <RegistryValue Value="URL:Orchestrion" Type="string" />
                <RegistryValue Name="URL Protocol" Value="" Type="string" />
                <RegistryValue Key="DefaultIcon" Value="$(var.Icon)" Type="string" />
                <RegistryValue Key="shell\open\command" Value="&quot;[INSTALL_ROOT]bin\$(var.ExeName)&quot; &quot;%1&quot;" Type="string" />
            </RegistryKey>
        </Component>

        <FeatureRef Id="ProductFeature">
            <!-- Step 3: Tell WiX to install the shortcut and types -->
            <ComponentRef Id="RegisterTypes" />
        </FeatureRef>

        <!-- Something from CMake-->
        <?include "product_fragment.wxi"?>
    </Product>
</Wix>
