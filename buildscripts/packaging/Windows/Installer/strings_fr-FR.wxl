<?xml version="1.0" encoding="utf-8"?>
<WixLocalization Culture="fr-FR" xmlns="http://schemas.microsoft.com/wix/2006/localization">
    <String Id="DowngradeErrorMessage">Une version plus récente d'[ProductName] est déjà installée. L'installation va maintenant se terminer.</String>
    <!-- The exit-dialog checkbox control does not format [ProductName], so the name is spelled out. -->
    <String Id="ExitDialogLaunchText">Lancer Orchestrion</String>

    <!-- Overrides of WixUIExtension's fr-FR strings: the stock translations
         say "de [ProductName]", which fails to elide before a vowel
         ("de Orchestrion"). Same text with "d'[ProductName]" instead. -->
